#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct Candidate {
    char name[100];
    int count;
};

int main() {
    int n;
    scanf("%d", &n);

    struct Candidate arr[1000];
    int size = 0;

    for (int i = 0; i < n; i++) {
        char name[100];
        scanf("%s", name);

        int found = -1;
        for (int j = 0; j < size; j++) {
            if (strcmp(arr[j].name, name) == 0) {
                found = j;
                break;
            }
        }

        if (found != -1) {
            arr[found].count++;
        } else {
            strcpy(arr[size].name, name);
            arr[size].count = 1;
            size++;
        }
    }

    int maxVotes = 0;
    char winner[100] = "";

    for (int i = 0; i < size; i++) {
        if (arr[i].count > maxVotes) {
            maxVotes = arr[i].count;
            strcpy(winner, arr[i].name);
        } else if (arr[i].count == maxVotes) {
            if (strcmp(arr[i].name, winner) < 0) {
                strcpy(winner, arr[i].name);
            }
        }
    }

    printf("%s %d", winner, maxVotes);
    return 0;
}
