#include <stdio.h>
#include <stdlib.h>

struct Node {
    int key;
    int value;
    struct Node* next;
};

#define SIZE 10007

struct Node* table[SIZE];

int hash(int key) {
    if (key < 0) key = -key;
    return key % SIZE;
}

void insert(int key, int value) {
    int idx = hash(key);
    struct Node* temp = table[idx];
    while (temp) {
        if (temp->key == key) return;
        temp = temp->next;
    }
    struct Node* node = (struct Node*)malloc(sizeof(struct Node));
    node->key = key;
    node->value = value;
    node->next = table[idx];
    table[idx] = node;
}

int search(int key) {
    int idx = hash(key);
    struct Node* temp = table[idx];
    while (temp) {
        if (temp->key == key) return temp->value;
        temp = temp->next;
    }
    return -1;
}

int main() {
    int n;
    scanf("%d", &n);

    int arr[n];
    for (int i = 0; i < n; i++) scanf("%d", &arr[i]);

    for (int i = 0; i < SIZE; i++) table[i] = NULL;

    int sum = 0, maxLen = 0;

    insert(0, -1);

    for (int i = 0; i < n; i++) {
        sum += arr[i];

        int idx = search(sum);
        if (idx != -1) {
            int len = i - idx;
            if (len > maxLen) maxLen = len;
        } else {
            insert(sum, i);
        }
    }

    printf("%d", maxLen);
    return 0;
}
