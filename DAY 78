#include <stdio.h>
#include <limits.h>

#define MAX 1000

int main() {
    int n, m;
    scanf("%d %d", &n, &m);

    int graph[MAX][MAX];

    for (int i = 1; i <= n; i++)
        for (int j = 1; j <= n; j++)
            graph[i][j] = 0;

    for (int i = 0; i < m; i++) {
        int u, v, w;
        scanf("%d %d %d", &u, &v, &w);
        graph[u][v] = w;
        graph[v][u] = w;
    }

    int key[MAX], vis[MAX];

    for (int i = 1; i <= n; i++) {
        key[i] = INT_MAX;
        vis[i] = 0;
    }

    key[1] = 0;
    int total = 0;

    for (int count = 1; count <= n; count++) {
        int u = -1, min = INT_MAX;

        for (int i = 1; i <= n; i++) {
            if (!vis[i] && key[i] < min) {
                min = key[i];
                u = i;
            }
        }

        vis[u] = 1;
        total += key[u];

        for (int v = 1; v <= n; v++) {
            if (graph[u][v] && !vis[v] && graph[u][v] < key[v]) {
                key[v] = graph[u][v];
            }
        }
    }

    printf("%d", total);
    return 0;
}
