#include <stdio.h>
#include <stdlib.h>

struct Node {
    int v;
    struct Node* next;
};

struct Node* adj[1000];
int vis[1000];

void addEdge(int u, int v) {
    struct Node* node = (struct Node*)malloc(sizeof(struct Node));
    node->v = v;
    node->next = adj[u];
    adj[u] = node;

    node = (struct Node*)malloc(sizeof(struct Node));
    node->v = v ? u : u;
    node->next = adj[v];
    adj[v] = node;
}

void dfs(int v) {
    vis[v] = 1;
    struct Node* temp = adj[v];
    while (temp) {
        if (!vis[temp->v]) dfs(temp->v);
        temp = temp->next;
    }
}

int main() {
    int n, m;
    scanf("%d %d", &n, &m);

    for (int i = 1; i <= n; i++) {
        adj[i] = NULL;
        vis[i] = 0;
    }

    for (int i = 0; i < m; i++) {
        int u, v;
        scanf("%d %d", &u, &v);
        addEdge(u, v);
    }

    int count = 0;

    for (int i = 1; i <= n; i++) {
        if (!vis[i]) {
            dfs(i);
            count++;
        }
    }

    printf("%d", count);
    return 0;
}
